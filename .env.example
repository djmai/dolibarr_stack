# ==============================================================================
#
#   DOLIBARR DOCKER STACK - Variables de Entorno
#
#   Este archivo centraliza TODA la configuración del proyecto.
#   Docker Compose lo lee automáticamente desde la raíz del proyecto.
#
#   ⚠️  IMPORTANTE:
#     - NO subir este archivo a Git (agregar a .gitignore).
#     - Cambiar TODAS las contraseñas antes de ir a producción.
#     - Después de modificar, ejecutar: docker compose up -d
#
#   📖 Sintaxis:  VARIABLE=valor
#     - Sin espacios alrededor del '='.
#     - Sin comillas (a menos que el valor tenga espacios).
#     - Los comentarios empiezan con '#'.
#
# ==============================================================================



# ------------------------------------------------------------------------------
#  🚀 APLICACIÓN (contenedor PHP + Nginx)
# ------------------------------------------------------------------------------
# Nombre del contenedor de la aplicación.
# Se usa en: docker-compose.yml -> services.app.container_name
# 💡 Útil para identificar el contenedor con: docker ps
APP_NAME=dolibarr

# Puerto del HOST donde se expondrá la aplicación.
# Se usa en: docker-compose.yml -> services.app.ports
# 💡 Cambia a 80 si no tienes otro servicio usando ese puerto.
# 💡 Accede luego en: http://localhost:8080
APP_PORT=8080

# Carpeta LOCAL (en el host) que contiene el código de Dolibarr.
# Se usa en: docker-compose.yml -> services.app.volumes
# 💡 Esta es la carpeta que Git versiona y donde editas el código.
APP_FOLDER=app

# Ruta INTERNA del contenedor donde se montará APP_FOLDER.
# Se usa en: docker-compose.yml -> services.app.volumes
# 💡 Normalmente no necesitas cambiarla.
APP_PATH=/app

# Entorno de ejecución: local | dev | staging | production
# Se usa en: docker-compose.yml -> services.app.environment
# 💡 Puedes usar esta variable en tu código PHP para activar/desactivar debug.
APP_ENV=local

# ------------------------------------------------------------------------------
#  🌐 DOMINIO LOCAL (Traefik)
# ------------------------------------------------------------------------------
# Dominio local que usarás para acceder a Dolibarr a través de Traefik.
# Se usa en: docker-compose.traefik.yml -> services.app.labels
#
# 💡 ¿CÓMO FUNCIONA?
#    1. Añade este dominio al archivo hosts de Windows:
#        127.0.0.1    dolibarr.local
#       (Ruta: C:\Windows\System32\drivers\etc\hosts)
#    2. Levanta el stack con Traefik:
#         make traefik-start
#    3. Accede desde el navegador:
#         http://dolibarr.local
#
# 💡 Puedes usar el sufijo que prefieras: .local, .test, .dev, etc.
APP_DOMAIN=dolibar.com
APP_DOMAIN_DEV=dolibarr.local

# ------------------------------------------------------------------------------
#  📧 EMAIL PARA LET'S ENCRYPT (Producción)
# ------------------------------------------------------------------------------
# Correo electrónico para recibir notificaciones de Let's Encrypt.
# Se usa en: docker-compose.traefik-ssl.yml -> services.traefik.command
# 💡 Cambia a tu correo real antes de ir a producción.
LETSENCRYPT_EMAIL=tu-email@ejemplo.com

# ------------------------------------------------------------------------------
#  🗄️  BASE DE DATOS (MariaDB)
# ------------------------------------------------------------------------------
# Nombre del contenedor de MariaDB.
# Se usa en: docker-compose.yml -> services.mariadb.container_name
# 💡 El hostname interno para conectarse desde la app es este mismo valor.
#    Ejemplo en Dolibarr: "mariadb" o "dolibarr_db".
DB_NAME=mariadb

# Contraseña del usuario ROOT de MariaDB.
# ⚠️  CAMBIAR EN PRODUCCIÓN. Usa algo como: openssl rand -base64 24
MARIA_ROOT_PASSWORD=rootpassword

# Nombre de la base de datos que usará Dolibarr.
# 💡 Se crea automáticamente en el primer arranque.
MARIA_DATABASE=dolibarr

# Usuario de la base de datos (NO uses root para la app).
MARIA_USER=dolibarr

# Contraseña del usuario de la base de datos.
# ⚠️  CAMBIAR EN PRODUCCIÓN.
MARIA_PASSWORD=dolibarr

# Puerto interno de MariaDB (no se expone al host por seguridad).
# 💡 Si necesitas conectarte desde fuera (ej. DBeaver), descomenta
#    el mapeo de puertos en docker-compose.yml y cambia este valor.
MARIA_PORT=3306



# ------------------------------------------------------------------------------
#  🌎 LOCALIZACIÓN
# ------------------------------------------------------------------------------
# Zona horaria del contenedor. Formato: Región/Ciudad
# Se usa en: docker-compose.yml -> services.*.environment.TZ
# 💡 Afecta logs, timestamps de archivos y fechas en Dolibarr.
# 💡 Lista completa: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=America/Mexico_City



# ------------------------------------------------------------------------------
#  👤 USUARIO DEL HOST (WSL / Linux)
# ------------------------------------------------------------------------------
# UID y GID del usuario del host que ejecuta Docker.
# Se usa en: docker-compose.yml -> services.app.user
#
# 💡 ¿POR QUÉ ES IMPORTANTE?
#    Docker monta carpetas del host dentro del contenedor. Si el UID del
#    usuario dentro del contenedor NO coincide con el tuyo, los archivos
#    creados por PHP (documentos, logs, cache) quedarán como "root" y no
#    podrás editarlos ni borrarlos desde tu usuario.
#
# 💡 ¿CÓMO OBTENERLOS?
#    Ejecuta en tu terminal WSL:
#        id -u    # Muestra tu UID (normalmente 1000)
#        id -g    # Muestra tu GID (normalmente 1000)
#
# 💡 VALORES COMUNES:
#    1000:1000  -> Primer usuario creado en Debian/Ubuntu (lo más común)
#    1001:1001  -> Segundo usuario
#    33:33      -> www-data (NO recomendado en WSL, causa problemas)
U_ID=1000
G_ID=1000



# ==============================================================================
#  📚 REFERENCIA RÁPIDA DE COMANDOS
# ==============================================================================
#
#   Levantar el stack:            docker compose up -d
#   Detener el stack:             docker compose down
#   Ver logs en vivo:             docker compose logs -f
#   Ver logs de un servicio:      docker compose logs -f app
#   Entrar al contenedor app:     docker compose exec app bash
#   Entrar a MariaDB:             docker compose exec mariadb mysql -u root -p
#   Reconstruir tras cambios:     docker compose up -d --build
#   Validar el compose:           docker compose config
#
# ==============================================================================